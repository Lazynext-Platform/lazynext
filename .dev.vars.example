# Cloudflare local cf:preview (Wrangler reads .dev.vars).
# D1 and R2 come from wrangler.jsonc bindings; DATABASE_URL/Blob token are not needed.
# In production use `wrangler secret put <KEY>`; do not commit .dev.vars.
NEXTAUTH_SECRET=        # openssl rand -base64 32
NEXTAUTH_URL=           # https://<worker subdomain or custom domain>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ATLASCLOUD_API_KEY=
DODO_PAYMENTS_API_KEY=  # get from Dodo Payments dashboard → Developer → API
DODO_PAYMENTS_WEBHOOK_KEY=  # get from Dodo Payments dashboard → Developer → Webhooks
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_STARTER=   # from: npm run setup:dodo
DODO_PRODUCT_PRO=
DODO_PRODUCT_ELITE=
PAYMENT_PROVIDER=dodo
