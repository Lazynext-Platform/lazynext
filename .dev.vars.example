# Cloudflare local cf:preview (Wrangler reads .dev.vars).
# D1 and R2 come from wrangler.jsonc bindings; DATABASE_URL/Blob token are not needed.
# In production use `wrangler secret put <KEY>`; do not commit .dev.vars.
NEXTAUTH_SECRET=        # openssl rand -base64 32
NEXTAUTH_URL=           # https://<worker subdomain or custom domain>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ATLASCLOUD_API_KEY=
STRIPE_SECRET_KEY=      # leave empty + PAYMENT_PROVIDER=atlas if not using Stripe
STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER=atlas
