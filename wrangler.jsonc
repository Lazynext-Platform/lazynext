{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lazynext",
  "account_id": "85953070bae00da372951a8833bd3459",
  "main": "worker-entry.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
  "r2_buckets": [
    { "bucket_name": "lazynext-studio-media", "binding": "MEDIA_BUCKET" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "lazynext-db", "database_id": "2b14197d-49b0-4d11-85e4-821ba3648ae3" }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "lazynext.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
