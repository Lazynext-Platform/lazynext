# Lazynext — Cloudflare environment variables.
# Cloudflare uses D1/R2 bindings (configured in wrangler.jsonc) instead of
# DATABASE_URL/BLOB_READ_WRITE_TOKEN. These env vars are set as Worker secrets
# via `wrangler secret put` or in the Cloudflare dashboard.

ATLASCLOUD_API_KEY="apikey-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ATLASCLOUD_BASE="https://api.atlascloud.ai/api/v1"

# Cloudflare R2 media storage (S3-compatible API).
# Create an R2 bucket named "lazynext-studio-media" and generate API tokens
# in the Cloudflare dashboard → R2 → Manage R2 API Tokens.
# The endpoint is https://<account_id>.r2.cloudflarestorage.com
R2_S3_ACCESS_KEY_ID=""
R2_S3_SECRET_ACCESS_KEY=""

NEXTAUTH_SECRET="change-me"
AUTH_SECRET="change-me"
# Local dev: use http://localhost:3000 (next dev) or http://localhost:8787 (wrangler dev).
# Production: set to your https:// domain in the Cloudflare dashboard or .dev.vars.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign In — https://developer.apple.com/account/resources/identifiers/list
# APPLE_CLIENT_ID="com.yourcompany.yourapp"
# APPLE_CLIENT_SECRET="generate-a-JWT-team-key-secret"
# Apple callback must be https://yourdomain/api/auth/callback/apple

# Kakao — https://developers.kakao.com/
# KAKAO_CLIENT_ID=""
# KAKAO_CLIENT_SECRET=""

# LINE — https://developers.line.biz/
# LINE_CLIENT_ID=""
# LINE_CLIENT_SECRET=""

# WeChat — https://open.weixin.qq.com/
# WECHAT_CLIENT_ID=""
# WECHAT_CLIENT_SECRET=""

PAYMENT_PROVIDER="dodo"

# Required only when PAYMENT_PROVIDER=dodo.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Product IDs from `npm run setup:dodo`:
DODO_PRODUCT_STARTER=""
DODO_PRODUCT_PRO=""
DODO_PRODUCT_ELITE=""

# Required only when PAYMENT_PROVIDER=atlas.
KUBEDL_ADMIN_BASE="https://console.atlascloud.ai/api/v1"
KUBEDL_ADMIN_APIKEY=""
KUBEDL_ATLAS_HEADER=""
ATLAS_REDEEM_CREDITS="100"

SIGNUP_BONUS_CREDITS="1000"

# Admin emails (comma-separated) — users with these emails get admin access
ADMIN_EMAILS="support@lazynext.com"

# Set to "false" to skip email verification enforcement at login (dev/test only).
# In production, leave unset or set to "true" — credentials users must verify their email.
ENFORCE_EMAIL_VERIFICATION="true"

# Email (Resend) — get your key at https://resend.com/api-keys
RESEND_API_KEY=""
FROM_EMAIL="Your Brand <noreply@yourdomain.com>"

# ─── Publishing & Scheduling ───
# Token encryption for OAuth tokens (REQUIRED in production — throws if missing)
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Cron secret for scheduled post processor (REQUIRED for cron trigger)
# Generate with: openssl rand -hex 32
# The cron trigger sends this as a Bearer token to /api/publish/process-scheduled
CRON_SECRET=""

# Platform OAuth credentials — set via `wrangler secret put` when ready to enable
# TikTok: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="https://yourdomain.com/api/publish/oauth/tiktok/callback"

# YouTube: https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="https://yourdomain.com/api/publish/oauth/youtube/callback"

# Instagram + Facebook (Meta): https://developers.facebook.com/
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://yourdomain.com/api/publish/oauth/instagram/callback"

# LinkedIn: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="https://yourdomain.com/api/publish/oauth/linkedin/callback"

# ─── Observability ───
# Alert webhook for critical pipeline failures and credit errors (optional)
# Configure to receive alerts on failures; falls back to console logging if not set
ALERT_WEBHOOK_URL=""
ALERT_WEBHOOK_SECRET=""

# ─── Model Overrides & LLM Configuration ───
# Atlas Cloud LLM base URL (separate from the media generation base)
ATLASCLOUD_LLM_BASE="https://api.atlascloud.ai/v1"
# Default chat model for LLM calls (overrides per-tier routing if set)
ATLASCLOUD_CHAT_MODEL=""
# Chat request timeout in milliseconds
ATLASCLOUD_CHAT_TIMEOUT_MS="30000"

# Creative intelligence model overrides (optional — defaults to tier-based routing)
CREATIVE_MODEL=""
CREATIVE_MAX_TOKENS="2000"
CREATIVE_TIMEOUT_MS="30000"

# Compliance checker model overrides
COMPLIANCE_MODEL=""
COMPLIANCE_MAX_TOKENS="1500"
COMPLIANCE_TIMEOUT_MS="30000"

# Brand extraction model overrides
BRAND_EXTRACTION_MODEL=""
BRAND_EXTRACTION_MAX_TOKENS="2000"
BRAND_EXTRACTION_TIMEOUT_MS="30000"

# URL-to-brief model overrides
URL_TO_BRIEF_MODEL=""
URL_TO_BRIEF_MAX_TOKENS="2000"
URL_TO_BRIEF_TIMEOUT_MS="30000"

# Drama studio model overrides
DRAMA_MODEL=""
DRAMA_FALLBACK_MODEL=""
DRAMA_SCRIPT_MAX_TOKENS="4000"

# ─── Atlas Media Model Overrides ───
# Override specific Atlas media generation models (optional)
ATLAS_IMAGE_EDIT_MODEL=""
ATLAS_TTS_MODEL=""
ATLAS_ASR_MODEL=""
ATLAS_VIDEO_MODEL=""
OCR_VISION_MODEL="vision-llm-ocr"

# ─── Lazynext Studio (Marketing Kit) Model Overrides ───
MK_EXPAND_MODEL=""
MK_PLAN_MODEL=""
MK_SHOT_IMAGE_MODEL=""
MK_SHOT_IMAGE_EDIT_MODEL=""
MK_SHOT_VIDEO_MODEL=""
MK_SHOT_REF_VIDEO_MODEL=""
MK_REPLICA_VIDEO_MODEL=""

# ─── Video Rendering (RendoBar) ───
# External FFmpeg/rendering service for EDL → video composition.
# See ADR-043 and research/video-rendering-services.md.
# Sign up at https://rendobar.com (Pro required for production).
VIDEO_RENDER_API_URL=""
VIDEO_RENDER_API_KEY=""
VIDEO_RENDER_WEBHOOK_SECRET=""
VIDEO_RENDER_TIMEOUT_MS="120000"
VIDEO_RENDER_POLL_MS="3000"

# ─── Social Media Publishing (optional) ───
# OAuth tokens for publishing creatives to social platforms.
# All optional — publishing features are hidden until configured.
# FB_PAGE_TOKEN=""
# INSTAGRAM_ACCESS_TOKEN=""
# LINKEDIN_ACCESS_TOKEN=""
# TIKTOK_ACCESS_TOKEN=""
# YOUTUBE_ACCESS_TOKEN=""

# ─── Google Analytics 4 (optional) ───
# GA4_PROPERTY_ID=""
# GOOGLE_APPLICATION_CREDENTIALS=""

# ─── Misc ───
# Next.js build target — set automatically by npm scripts (local|cloudflare).
# BUILD_TARGET="local"
# Public site URL (used for canonical URLs and OG metadata).
# NEXT_PUBLIC_SITE_URL="https://lazynext.com"
# Drama script generation timeout (ms).
# DRAMA_SCRIPT_TIMEOUT_MS="30000"
# E2E test flag — disables rate limiting during test runs.
# E2E_NO_RATE_LIMIT="1"
