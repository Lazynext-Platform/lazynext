# Lazynext — Vercel/local Next.js environment variables.
# Cloudflare uses D1/R2 bindings instead of DATABASE_URL/BLOB_READ_WRITE_TOKEN.

ATLASCLOUD_API_KEY="apikey-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ATLASCLOUD_BASE="https://api.atlascloud.ai/api/v1"

# Vercel database: pooled Neon URL for runtime and optional direct URL for
# `npm run db:push:vercel`.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Connect a PUBLIC Vercel Blob store to the project. Vercel normally injects
# this variable automatically.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxx"

# Optional while existing records still reference Cloudflare R2 paths.
CLOUDFLARE_MEDIA_BASE_URL="https://your-worker.workers.dev"

NEXTAUTH_SECRET="change-me"
# Local dev: use http://localhost:3000 (next dev) or http://localhost:8787 (wrangler dev).
# Production: set to your https:// domain in the hosting platform's env vars (NOT here).
# NOTE: the app forces non-secure cookies in dev mode, so local auth works even if
# you accidentally leave a production URL here — but OAuth redirects still need the
# correct localhost URL to return to your local server after Google sign-in.
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign In — https://developer.apple.com/account/resources/identifiers/list
# APPLE_CLIENT_ID="com.yourcompany.yourapp"
# APPLE_CLIENT_SECRET="generate-a-JWT-team-key-secret"
# Apple callback must be https://yourdomain/api/auth/callback/apple

# Kakao — https://developers.kakao.com/
# KAKAO_CLIENT_ID=""
# KAKAO_CLIENT_SECRET=""

# LINE — https://developers.line.biz/
# LINE_CLIENT_ID=""
# LINE_CLIENT_SECRET=""

# WeChat — https://open.weixin.qq.com/
# WECHAT_CLIENT_ID=""
# WECHAT_CLIENT_SECRET=""

PAYMENT_PROVIDER="dodo"

# Required only when PAYMENT_PROVIDER=dodo.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Product IDs from `npm run setup:dodo`:
DODO_PRODUCT_STARTER=""
DODO_PRODUCT_PRO=""
DODO_PRODUCT_ELITE=""

# Required only when PAYMENT_PROVIDER=atlas.
KUBEDL_ADMIN_BASE="https://console.atlascloud.ai/api/v1"
KUBEDL_ADMIN_APIKEY=""
KUBEDL_ATLAS_HEADER=""
ATLAS_REDEEM_CREDITS="100"

SIGNUP_BONUS_CREDITS="20"

# Local override only. Vercel sets VERCEL=1 automatically.
# DEPLOY_TARGET="vercel"
