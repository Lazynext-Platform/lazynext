// Lazynext — canonical data model.
// This SQLite schema generates the Cloudflare D1 client via Prisma.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "sqlite"
}

// ── NextAuth standard models ──
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed password for email+password auth (null for OAuth-only users)
  credits       Int       @default(0) // current balance snapshot
  // ── Global i18n / billing preferences (persisted per user) ──
  locale        String?   // UI language code: en, zh, ja, es, ko, pt, fr, de, ar, hi …
  country       String?   // ISO 3166-1 alpha-2 country code (e.g. US, CN, JP, IN, BR)
  currency      String?   // ISO 4217 currency code (e.g. USD, EUR, JPY, CNY, INR, BRL)
  notificationPrefs String? // JSON string of notification type → {inApp, email} preferences
  // ── MFA (TOTP) ──
  mfaSecret     String?   // encrypted TOTP secret (null = MFA not enabled)
  mfaEnabled    Boolean   @default(false)
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  creations Creation[]
  ledger    CreditLedger[]
  adProducts AdProduct[]
  adAvatars  AdAvatar[]
  brandKits  BrandKit[]
  brandProfiles BrandProfile[]
  assets     Asset[]
  workflowRuns WorkflowRun[]
  adCampaigns  AdCampaign[]
  creativePerformance CreativePerformance[]
  timelines  Timeline[]
  editingSkills EditingSkill[]
  creativeTemplates CreativeTemplate[]
  sharedLinks  SharedLink[]
  webhookEndpoints WebhookEndpoint[]
  messages     Message[]
  dataRequests DataRequest[]
  creativeComments CreativeComment[]
  teamMembers  TeamMember[]
  teamActivities TeamActivity[]
  customComplianceRules CustomComplianceRule[]
  platformConnections PlatformConnection[]
  scheduledPosts ScheduledPost[]
  hooks        Hook[]
  // ── OS Platform relations (Phase 3) ──
  memberships     Membership[]
  organizations   Organization[]
  apiKeys         ApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  revokedAt    DateTime? // set when session is revoked (logout-all, admin force-logout)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App models ──
model Creation {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  model      String
  prompt     String  
  inputImage String? 
  status     String   @default("pending") // pending | processing | persisting | completed | failed
  taskId     String?
  getUrl     String? 
  outputs    Json?
  assets     Json?    // drama 作品文件夹:结构化中间资产(kind/characters[定妆图]/sceneImage/scenes[首帧+视频]/finalVideo);其它类型为 null
  error      String?
  cost       Int      @default(0) // credits charged
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  timelines Timeline[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([taskId])
  @@index([getUrl])
}

model CreditLedger {
  id             String   @id @default(cuid())
  userId         String
  delta          Int // +grant / -spend
  reason         String // signup | purchase | redeem | generate | refund
  ref            String? // stripe session id / cdkey / creation id
  idempotencyKey String? // unique key for pipeline stage charges to prevent double-charging
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, idempotencyKey])
  @@index([reason])
  @@index([ref])
}

// Prevents the same Atlas redeem code being used twice in this app.
model RedeemedCode {
  code      String   @id
  userId    String
  amount    Int
  createdAt DateTime @default(now())
}

// ── Reusable asset layer (reusable assets, modeled on Higgsfield Product/Avatar/BrandKit) ──
model AdProduct {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   // 英文产品锚(锁跨镜一致)
  imageUrl    String?  // 产品参考图 URL
  sourceUrl   String?  // URL 导入来源
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdAvatar {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   // 英文人物描述
  imageUrl    String?  // 数字人定妆图 URL
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BrandKit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  logoUrl   String?
  colors    Json? // 品牌色数组
  fontNote  String?
  toneNote  String?  // 语气/风格
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BrandProfile {
  id              String   @id @default(cuid())
  userId          String
  company         String
  domain          String
  industry        String
  positioning     String?
  audience        String?
  tone            String?
  visualStyle     String?
  colors          Json?    // string[]
  fonts           Json?    // string[]
  prohibitedClaims Json?   // string[]
  brandVocabulary Json?    // string[]
  sourceUrls      Json?    // string[]
  extractionTimestamp DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Unified asset system (lineage, versions, tags, reuse) ──
model Asset {
  id          String   @id @default(cuid())
  userId      String
  type        String   // image | video | audio | script | storyboard | brief | brand_profile
  name        String
  sourceUrl   String?  // original source (R2 URL, external URL, etc.)
  parentId    String?  // lineage: parent asset this was derived from
  tags        Json?    // string[]
  metadata    Json?    // type-specific metadata
  createdAt   DateTime @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    AssetVersion[]
  approvalStages ApprovalStage[]

  @@index([userId])
  @@index([parentId])
}

model SharedLink {
  id          String    @id @default(cuid())
  userId      String   // owner who created the share link
  assetId     String   // the asset being shared
  token       String   @unique // random token for the share URL
  password    String?  // optional bcrypt hash
  expiresAt   DateTime? // optional expiry
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assetId])
  @@index([token])
  @@index([expiresAt])
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  userId      String
  url         String   // callback URL
  secret      String   // signing secret for HMAC
  events      String   // comma-separated list of events to subscribe to
  active      Boolean  @default(true)
  lastFiredAt DateTime?
  lastStatus  Int?     // last HTTP response status code
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active, events])
}

model CreativeComment {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  parentId  String?  // for threaded replies
  body      String   // comment text (supports @mentions)
  mentions  String   @default("[]") // JSON array of mentioned userIds
  resolved  Boolean  @default(false) // for comment resolution
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assetId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamMember[]
  invitations TeamInvitation[]
  activities  TeamActivity[]

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("viewer") // owner | editor | viewer
  joinedAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvitation {
  id         String    @id @default(cuid())
  teamId     String
  email      String
  role       String    @default("viewer") // editor | viewer
  token      String    @unique
  invitedBy  String
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
  @@index([expiresAt])
}

model TeamActivity {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  type      String   // member_joined | member_left | role_changed | project_created | project_updated | comment_added | approval_requested | approval_granted
  summary   String
  metadataJson String @default("{}")
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([userId])
}

model ApprovalStage {
  id          String   @id @default(cuid())
  assetId     String?
  campaignId  String?
  stage       String   @default("creative_review") // creative_review | brand_review | legal_review | final_approval
  status      String   @default("pending") // pending | approved | rejected | changes_requested
  reviewerId  String?
  note        String?
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?

  asset    Asset?      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  campaign AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([campaignId])
  @@index([stage])
  @@index([status])
}

model AssetVersion {
  id          String   @id @default(cuid())
  assetId     String
  version     Int      @default(1)
  url         String   // R2 or external URL for this version
  metadata    Json?    // version-specific metadata (resolution, duration, etc.)
  createdAt   DateTime @default(now())

  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

// ── Workflow engine state (durable step tracking) ──
model WorkflowRun {
  id           String   @id @default(cuid())
  userId       String
  workflowType String
  status       String   @default("running") // running | completed | failed | cancelled
  input        Json?
  output       Json?
  error        String?
  version      Int      @default(0) // optimistic locking for pipeline state
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model WorkflowStep {
  id          String   @id @default(cuid())
  runId       String
  stepName    String
  status      String   @default("pending") // pending | running | completed | failed | skipped
  input       Json?
  output      Json?
  error       String?
  creditsCost Int?
  startedAt   DateTime?
  completedAt DateTime?

  @@index([runId])
}

// ── Ad platform integrations ──
model AdCampaign {
  id           String   @id @default(cuid())
  userId       String
  platform     String   // meta | google
  campaignId   String?  // external platform campaign ID
  name         String
  status       String   @default("draft") // draft | pending_approval | active | paused | completed
  budgetDaily  Float?
  budgetTotal  Float?
  currency     String   @default("USD")
  targeting    Json?    // audience targeting config
  creativeIds  Json?    // string[] of Creation IDs
  metrics      Json?    // { impressions, clicks, conversions, spend, roas }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalStages ApprovalStage[]

  @@index([userId])
  @@index([platform])
}

// ── Performance learning ──
model CreativePerformance {
  id            String   @id @default(cuid())
  userId        String
  creationId    String
  campaignId    String?
  platform      String
  hookType      String?
  angleName     String?
  variantId     String?
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  spend         Float    @default(0)
  revenue       Float    @default(0)
  ctr           Float    @default(0)
  cvr           Float    @default(0)
  roas          Float    @default(0)
  recordedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([creationId])
  @@index([platform])
}

// ── Native video editor timeline ──
model Timeline {
  id          String   @id @default(cuid())
  userId      String
  creationId  String?  // optional link to the Creation this timeline edits
  name        String
  durationSec Float    @default(0) // total timeline duration in seconds
  fps         Int      @default(30) // frames per second
  ratio       String   @default("16:9") // aspect ratio: 16:9 | 9:16 | 1:1 | 4:5 | 4:3 | 21:9
  tracksJson  String   @default("[]") // serialized Track[] (clips nested inside)
  markersJson String   @default("[]") // serialized Marker[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creation  Creation?  @relation(fields: [creationId], references: [id], onDelete: SetNull)
  versions  TimelineVersion[]

  @@index([userId])
  @@index([creationId])
}

model TimelineVersion {
  id          String   @id @default(cuid())
  timelineId  String
  versionNum  Int      // sequential version number (1, 2, 3, ...)
  name        String   @default("") // optional label for this version
  tracksJson  String   @default("[]") // serialized Track[] snapshot
  markersJson String   @default("[]") // serialized Marker[] snapshot
  durationSec Float    @default(0)
  createdAt   DateTime @default(now())

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId])
  @@unique([timelineId, versionNum])
}

model EditingSkill {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  contentTypesJson String @default("[]") // serialized ContentType[]
  platformsJson    String @default("[]") // serialized string[]
  stepsJson        String @default("[]") // serialized EditStep[]
  estimatedTimeMin Int      @default(5)
  tagsJson         String   @default("[]") // serialized string[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Creative Template Library ──
// Pre-built and user-saved templates for creative briefs, hook formulas,
// script structures, and editing skill bundles.  Built-in templates are
// seeded at startup; user templates are persisted per-user.
model CreativeTemplate {
  id          String   @id @default(cuid())
  userId      String?  // null = built-in template, non-null = user-saved
  category    String   // "brief" | "hooks" | "angles" | "script" | "skill-bundle"
  name        String
  description String   @default("")
  // Serialized template payload — shape depends on category:
  //   brief: { product, audience, tone, goals, ... }
  //   hooks: { hooks: [{ type, text, ... }] }
  //   angles: { angles: [{ name, description, ... }] }
  //   script: { structure, scenes, ... }
  //   skill-bundle: { skillIds: [...], skills: [...] }
  payloadJson String   @default("{}")
  tagsJson    String   @default("[]") // serialized string[]
  isFavorite  Boolean  @default(false) // user can favorite templates
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

// ── Custom compliance rules (user-defined, per-platform) ──

model CustomComplianceRule {
  id          String   @id @default(cuid())
  userId      String   // owner
  platform    String   // tiktok | youtube | meta | google | universal
  enabled     Boolean  @default(true)
  priority    Int      @default(0) // higher = checked first
  category    String   // ComplianceCategory (prohibited_content, restricted_content, etc.)
  title       String   // short rule title
  description String   // what this rule checks
  keywordsJson String  @default("[]") // serialized string[]
  recommendation String // how to fix
  severity    String   @default("medium") // critical | high | medium | low | info
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@index([enabled])
}

// ── Publishing: OAuth tokens & scheduled posts ──

model PlatformConnection {
  id           String   @id @default(cuid())
  userId       String
  platform     String   // tiktok | youtube | instagram | facebook | linkedin
  accessToken  String
  refreshToken String?
  tokenExpiresAt DateTime?
  platformUserId String? // platform-specific user/page ID
  platformUsername String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
}

model ScheduledPost {
  id          String    @id @default(cuid())
  userId      String
  platform    String    // tiktok | youtube | instagram | facebook | linkedin
  mediaUrl    String
  caption     String
  hashtagsJson String   @default("[]") // serialized string[] of hashtags
  privacyLevel String?  // public | private | followers (platform-specific)
  crossPostToJson String @default("[]") // serialized string[] of cross-post target platforms
  postUrl     String?   // filled after actual publish
  postId      String?   // platform-specific post ID after publish
  scheduledAt DateTime  // when to publish
  status      String    @default("scheduled") // scheduled | publishing | published | failed | cancelled
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([status, scheduledAt])
}

// ── Meta Ads Safety Layer: persisted audit log & approval workflow ──
// These tables back the D1 persistence path in src/lib/ads/meta-safety.ts.
// The in-memory Maps remain as a fallback for tests and dry-run mode.

model MetaSafetyAudit {
  id        String   @id @default(cuid())
  action    String
  actor     String
  timestamp DateTime @default(now())
  dryRun    Boolean
  approved  Boolean
  payload   String
  result    String
  spendDelta Float   @default(0)

  @@index([actor])
  @@index([timestamp])
}

model MetaSafetyApproval {
  id        String   @id @default(cuid())
  action    String
  payload   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  expiresAt DateTime
  approvedBy String?
  approvedAt DateTime?

  @@index([status])
  @@index([expiresAt])
}

// ── Google Ads Safety Layer: audit log & approval state (D1-persisted) ──

model GoogleSafetyAudit {
  id        String   @id @default(cuid())
  action    String
  actor     String
  timestamp DateTime @default(now())
  dryRun    Boolean
  approved  Boolean
  payload   String
  result    String
  spendDelta Float   @default(0)

  @@index([actor])
  @@index([timestamp])
}

model GoogleSafetyApproval {
  id        String   @id @default(cuid())
  action    String
  payload   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  expiresAt DateTime
  approvedBy String?
  approvedAt DateTime?

  @@index([status])
  @@index([expiresAt])
}

// ── Hook Library: AI-generated reusable ad hooks (D1-persisted per user) ──
// Backs the persistence path in src/lib/creative/hook-library.ts. Hooks are
// generated via Atlas LLM (or heuristic dry-run fallback), stored here so they
// survive deploys, and retrieved/filtered per user.

model Hook {
  id              String   @id @default(cuid())
  userId          String
  text            String
  trigger         String
  platforms       String   // JSON array stored as string (Platform[])
  performanceScore Int
  productOrBrand  String?
  audience        String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, trigger])
}

// ─────────────────────────────────────────────────────────────────────────────
// OS Platform Models (Phase 3 — additive, no changes to existing models)
// These introduce workspace-based tenancy alongside the existing user-scoped
// data. Existing data is migrated incrementally; old models remain untouched.
// ─────────────────────────────────────────────────────────────────────────────

// An organization is a company/team entity that owns one or more workspaces.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  plan      String   @default("free") // free | pro | team | enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id])
  workspaces Workspace[]

  @@index([ownerId])
}

// A workspace is the tenancy boundary for all business data.
model Workspace {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  slug            String   @unique
  defaultLocale   String   @default("en")
  timezone        String   @default("UTC")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  projects        Project[]
  documents       Document[]
  files           FileStore[]
  automations     Automation[]
  agents          AgentDef[]
  notifications   Notification[]
  conversations   Conversation[]
  scheduledJobs   ScheduledJob[]
  auditEvents     AuditEvent[]

  @@index([organizationId])
}

// User ↔ Workspace relationship with a role.
model Membership {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  role         String   @default("member") // owner | admin | member | viewer | guest
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// A project is a container for related work (tasks, documents, files).
model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  status      String   @default("active") // active | archived | deleted
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  documents   Document[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

// A task is a unit of work within a project.
model Task {
  id          String   @id @default(cuid())
  projectId   String
  assigneeId  String?
  title       String
  description String?
  status      String   @default("todo") // todo | in_progress | done | cancelled
  priority    String   @default("medium") // low | medium | high | urgent
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

// A document is a rich-text knowledge object.
model Document {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  content     String   // markdown / rich text
  version     Int      @default(1)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
}

// A file is a stored binary asset with metadata (distinct from creative Asset).
model FileStore {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  mimeType    String
  size        Int
  storageKey  String   // R2 key or local path
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// An automation is a workflow definition (trigger → steps → action).
model Automation {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  trigger     String   // event type or cron expression
  enabled     Boolean  @default(true)
  definition  String   // JSON: steps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        AutomationRun[]

  @@index([workspaceId])
}

model AutomationRun {
  id          String   @id @default(cuid())
  automationId String
  status      String   @default("pending") // pending | running | completed | failed
  startedAt   DateTime @default(now())
  completedAt DateTime?

  automation  Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([status])
}

// An AI agent definition.
model AgentDef {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  modelProvider String
  modelName     String
  instructions  String
  toolIds       String   // JSON array of tool IDs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs          AgentRun[]

  @@index([workspaceId])
}

model AgentRun {
  id          String   @id @default(cuid())
  agentId     String
  status      String   @default("running") // running | completed | failed | cancelled
  input       String
  output      String?
  tokensUsed  Int      @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  agent       AgentDef @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
}

// A user-facing notification.
model Notification {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  type        String
  title       String
  body        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([workspaceId])
}

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([workspaceId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  body           String
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
}

// A scheduled job (cron or one-shot).
model ScheduledJob {
  id          String   @id @default(cuid())
  workspaceId String
  type        String
  payload     String   // JSON
  scheduledAt DateTime
  status      String   @default("pending") // pending | running | completed | failed
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([scheduledAt])
}

// A security/business-critical audit record.
model AuditEvent {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  action      String   // auth.login, user.create, role.update, ...
  targetType  String?
  targetId    String?
  metadata    String?  // JSON
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([action])
}

// API key for public API v1 access.
model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  name        String
  keyHash     String    @unique  // SHA-256 hash of the key (never store plaintext)
  keyPrefix   String    // first 8 chars for display (e.g. "ln_live_")
  scopes      String    @default("[]")  // JSON array: ["read", "write", "admin"]
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// GDPR/data-subject access request (filed via /data-request page).
model DataRequest {
  id         String   @id @default(cuid())
  userId     String?
  type       String   // access | correction | deletion | portability | restriction | objection
  email      String
  name       String?
  details    String?
  status     String   @default("pending") // pending | in_review | completed | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
