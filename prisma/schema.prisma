// A workspace is the tenancy boundary for all business data.
model Workspace {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  slug            String   @unique
  defaultLocale   String   @default("en")
  timezone        String   @default("UTC")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  projects        Project[]
  documents       Document[]
  files           FileStore[]
  automations     Automation[]
  agents          AgentDef[]
  notifications   Notification[]
  conversations   Conversation[]
  scheduledJobs   ScheduledJob[]
  auditEvents     AuditEvent[]
  // ── Phase 4 relations ──
  goals           Goal[]
  kpis            Kpi[]
  plans           Plan[]
  toolDefs        ToolDef[]
  toolCalls       ToolCall[]
  approvals       Approval[]
  budgets         Budget[]
  memories        Memory[]
  events          Event[]
  opportunities   DetectedOpportunity[]
  recommendations Recommendation[]
  // ── Phase 5 relations ──
  products        Product[]
  customers       Customer[]
  initiatives     Initiative[]
  deals           Deal[]
  transactions    Transaction[]
  // ── Phase 7+ relations ──
  knowledgeBases  KnowledgeBase[]
  researchSessions ResearchSession[]
  securityEvents  SecurityEvent[]
  metrics         Metric[]
  // ── Phase 8 relations ──
  tickets         Ticket[]
  sandboxRuns     SandboxRun[]
  workspaceQuotas WorkspaceQuota[]
  // ── Phase 9 relations ──
  policies        Policy[]
  complianceChecks ComplianceCheck[]
  deployments     Deployment[]
  // ── R3: safety layer tenancy relations ──
  metaSafetyAudits    MetaSafetyAudit[]
  metaSafetyApprovals MetaSafetyApproval[]
  googleSafetyAudits    GoogleSafetyAudit[]
  googleSafetyApprovals GoogleSafetyApproval[]
  // ── R16: creative model tenancy relations ──
  creations             Creation[]
  adProducts            AdProduct[]
  adAvatars             AdAvatar[]
  brandKits             BrandKit[]
  brandProfiles         BrandProfile[]
  assets                Asset[]
  sharedLinks           SharedLink[]
  creativeComments      CreativeComment[]
  workflowRuns          WorkflowRun[]
  adCampaigns           AdCampaign[]
  creativePerformance   CreativePerformance[]
  timelines             Timeline[]
  editingSkills         EditingSkill[]
  creativeTemplates     CreativeTemplate[]
  scheduledPosts        ScheduledPost[]
  hooks                 Hook[]

  @@index([organizationId])
}

// User ↔ Workspace relationship with a role.
model Membership {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  role         String   @default("member") // owner | admin | member | viewer | guest
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// A project is a container for related work (tasks, documents, files).
model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  status      String   @default("active") // active | archived | deleted
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  documents   Document[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

// A task is a unit of work within a project.
model Task {
  id              String   @id @default(cuid())
  projectId       String
  assigneeId      String?
  title           String
  description     String?
  status          String   @default("todo") // todo | in_progress | done | cancelled | blocked | awaiting_approval | failed | retrying | verified
  priority        String   @default("medium") // low | medium | high | urgent
  dueDate         DateTime?
  // ── Autonomous execution fields (Phase 4 — additive) ──
  assignedAgentId String?
  planId          String?
  parentTaskId    String?
  toolIds         String?  // JSON array of tool IDs
  inputs          String?  // JSON
  outputs         String?  // JSON
  verification    String?  // JSON: verification criteria and results
  estimatedCost   Int      @default(0) // credits
  budgetLimit     Int?     // credits
  timeoutSec      Int?
  retryPolicy     String?  // JSON: { maxRetries, backoffMs }
  retryCount      Int      @default(0)
  idempotencyKey  String?
  riskLevel       String   @default("low") // low | medium | high
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // ── Phase 6 relations ──
  dependencies    TaskDependency[] @relation("TaskDependsOn") // tasks this task depends on
  dependents      TaskDependency[] @relation("TaskIsDependedBy") // tasks that depend on this task
  timeEntries     TimeEntry[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([planId])
  @@index([parentTaskId])
  @@index([idempotencyKey])
}

// ── Phase 6: Task dependencies (blocking relationships) ──
model TaskDependency {
  id           String   @id @default(cuid())
  taskId       String   // the task that depends on another
  dependsOnId  String   // the task being depended upon
  type         String   @default("blocks") // blocks | finish_to_start | start_to_start | finish_to_finish
  createdAt    DateTime @default(now())

  task         Task @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn    Task @relation("TaskIsDependedBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
}

// ── Phase 6: Time tracking ──
model TimeEntry {
  id          String   @id @default(cuid())
  taskId      String
  userId      String?
  agentRunId  String?
  durationSec Int      @default(0)
  description String?
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  createdAt   DateTime @default(now())

  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([agentRunId])
}

// A document is a rich-text knowledge object.
model Document {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  content     String   // markdown / rich text
  version     Int      @default(1)
  // ── Phase E: public website publishing ──
  published   Boolean  @default(false)
  publishedAt DateTime?
  publishSlug  String?  // URL slug for public access (e.g. "landing-page")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
}

// A file is a stored binary asset with metadata (distinct from creative Asset).
model FileStore {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  mimeType    String
  size        Int
  storageKey  String   // R2 key or local path
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// An automation is a workflow definition (trigger → steps → action).
model Automation {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  trigger     String   // event type or cron expression
  enabled     Boolean  @default(true)
  definition  String   // JSON: steps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        AutomationRun[]

  @@index([workspaceId])
}

model AutomationRun {
  id          String   @id @default(cuid())
  automationId String
  status      String   @default("pending") // pending | running | completed | failed
  startedAt   DateTime @default(now())
  completedAt DateTime?

  automation  Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([status])
}

// An AI agent definition.
model AgentDef {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  role            String   @default("custom") // ceo | engineering | strategy | research | product | design | growth | sales | support | finance | operations | security | custom
  modelProvider   String
  modelName       String
  instructions    String
  toolIds         String   @default("[]") // JSON array of tool IDs
  // ── Autonomous execution fields (Phase 4 — additive) ──
  capabilities    String   @default("[]") // JSON array (R19: left as String — changing to Json breaks consuming code)
  permissions     String   @default("[]") // JSON array
  memoryAccess    String   @default("scoped") // full | scoped | none
  contextRules    String   @default("[]") // JSON array
  budgetLimit     Int?     // credits
  maxConcurrency  Int      @default(1)
  timeoutSec      Int      @default(300)
  executionPolicy String   @default("{}") // JSON: retry, backoff
  verificationPolicy String @default("{}") // JSON: verification rules (R19: left as String — changing to Json breaks consuming code)
  // ── Reward engine (Phase C — additive) ──
  performanceStats String? // JSON: rolling score averages, reward/correction/failure counts
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs            AgentRun[]

  @@index([workspaceId])
  @@index([role])
}

model AgentRun {
  id              String   @id @default(cuid())
  agentId         String
  taskId          String?
  planId          String?
  status          String   @default("pending") // pending | running | completed | failed | cancelled | retrying
  input           String   @default("{}") // JSON
  output          String?  // JSON (R19: left as String — changing to Json breaks consuming code)
  toolCalls       String   @default("[]") // JSON array of ToolCall summaries (R19: left as String — changing to Json breaks consuming code)
  verification    String?  // JSON: verification result
  result          String?  // JSON: structured result
  tokensUsed      Int      @default(0)
  costCredits     Int      @default(0)
  retryCount      Int      @default(0)
  idempotencyKey  String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  agent           AgentDef @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // ── R18: back-relation for ToolCall.agentRunId ──
  toolCallRecords ToolCall[]

  @@index([agentId])
  @@index([status])
  @@index([taskId])
  @@index([planId])
  @@index([idempotencyKey])
}

// A user-facing notification.
model Notification {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  type        String
  title       String
  body        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([workspaceId])
}

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([workspaceId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  body           String
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
}

// A scheduled job (cron or one-shot).
model ScheduledJob {
  id              String   @id @default(cuid())
  workspaceId     String
  type            String
  payload         String   // JSON
  scheduledAt     DateTime
  status          String   @default("pending") // pending | running | completed | failed | dead_letter
  // ── Durable job engine fields (Phase 4 — additive) ──
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  backoffMs       Int      @default(1000)
  deadLetterAt    DateTime?
  idempotencyKey  String?
  ownerId         String?
  agentRunId      String?
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([idempotencyKey])
  @@index([agentRunId])
}

// A security/business-critical audit record.
model AuditEvent {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  action      String   // auth.login, user.create, role.update, ...
  targetType  String?
  targetId    String?
  metadata    String?  // JSON
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([action])
}

// API key for public API v1 access.
model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  name        String
  keyHash     String    @unique  // SHA-256 hash of the key (never store plaintext)
  keyPrefix   String    // first 8 chars for display (e.g. "ln_live_")
  scopes      String    @default("[]")  // JSON array: ["read", "write", "admin"]
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// GDPR/data-subject access request (filed via /data-request page).
model DataRequest {
  id         String   @id @default(cuid())
  userId     String?
  type       String   // access | correction | deletion | portability | restriction | objection
  email      String
  name       String?
  details    String?
  status     String   @default("pending") // pending | in_review | completed | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Company Model & Core OS Primitives (additive)
// These extend the OS platform with the foundational primitives needed for
// the Autonomous Company Operating System. All new tables; no changes to
// existing models except additive nullable fields on Organization.
// ─────────────────────────────────────────────────────────────────────────────

// A company goal/objective — linked to Organization (Company).
model Goal {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  title           String
  description     String?
  type            String   @default("objective") // objective | key_result | initiative | milestone
  status          String   @default("active") // active | completed | cancelled | paused
  priority        String   @default("medium") // low | medium | high | urgent
  progress        Float    @default(0) // 0.0 - 1.0
  dueDate         DateTime?
  parentGoalId    String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  parentGoal      Goal?        @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  childGoals      Goal[]       @relation("GoalHierarchy")
  kpis            Kpi[]
  plans           Plan[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@index([parentGoalId])
}

// A key performance indicator — measures progress toward a goal.
model Kpi {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  goalId          String?
  name            String
  description     String?
  target          Float    @default(0)
  current         Float    @default(0)
  unit            String   @default("count") // count | percent | currency | duration
  period          String   @default("monthly") // daily | weekly | monthly | quarterly | yearly
  direction       String   @default("up") // up (higher is better) | down (lower is better)
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  goal            Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([goalId])
}

// A durable plan — output of the Planner, contains objective + tasks.
model Plan {
  id              String   @id @default(cuid())
  workspaceId     String
  organizationId  String
  goalId          String?
  title           String
  objective       String
  reasoning       String?  // summary for logs
  status          String   @default("draft") // draft | active | completed | cancelled | failed
  priority        String   @default("medium")
  riskLevel       String   @default("low")
  estimatedCost   Int      @default(0) // credits
  createdById     String?
  agentId         String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goal            Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([organizationId])
  @@index([goalId])
  @@index([status])
}

// A tool definition in the centralized tool registry.
model ToolDef {
  id              String   @id @default(cuid())
  workspaceId     String?
  name            String
  version         String   @default("1.0.0")
  description     String
  inputSchema     String   @default("{}") // JSON Schema
  outputSchema    String   @default("{}") // JSON Schema
  authRequirements String  @default("{}") // JSON
  permissions     String   @default("[]") // JSON array
  riskCategory    String   @default("low") // low | medium | high
  budgetCategory  String   @default("none") // none | credits | api_cost | compute_cost | ad_spend
  timeoutSec      Int      @default(30)
  retryPolicy     String   @default("{}") // JSON: { maxRetries, backoffMs }
  auditRequired   Boolean  @default(true)
  allowedAgents   String   @default("[]") // JSON array of agent roles
  allowedCompanies String  @default("[]") // JSON array of org IDs (empty = all)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolCalls       ToolCall[]

  @@index([workspaceId])
  @@index([name])
}

// A tool invocation record — audit trail for every tool call.
model ToolCall {
  id              String   @id @default(cuid())
  workspaceId     String
  agentRunId      String?
  toolDefId       String
  input           String   @default("{}") // JSON
  output          String?  // JSON
  status          String   @default("pending") // pending | running | completed | failed | timeout
  error           String?
  costCredits     Int      @default(0)
  riskScore       Float    @default(0)
  approved        Boolean  @default(false)
  approvedBy      String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolDef         ToolDef   @relation(fields: [toolDefId], references: [id], onDelete: Restrict)
  // ── R18: relation for scalar agentRunId foreign key ──
  agentRun        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([agentRunId])
  @@index([toolDefId])
  @@index([status])
}

// A centralized approval request — for high-risk actions.
model Approval {
  id              String   @id @default(cuid())
  workspaceId     String
  organizationId  String
  agentRunId      String?
  toolCallId      String?
  taskId          String?
  action          String
  description     String
  riskLevel       String   @default("medium") // low | medium | high
  estimatedCost   Int      @default(0) // credits
  affectedResources String  @default("[]") // JSON array
  status          String   @default("pending") // pending | approved | rejected | expired | cancelled
  requestedBy     String
  approverId      String?
  decision        String?  // approved | rejected | modified
  note            String?
  expiresAt       DateTime?
  decidedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
}

// A budget — multi-level spending controls.
model Budget {
  id              String   @id @default(cuid())
  workspaceId     String
  organizationId  String
  scope           String   // company | workspace | agent | task | integration | campaign | period
  scopeId         String?  // ID of the scoped entity (agentId, taskId, etc.)
  period          String   @default("monthly") // daily | weekly | monthly | quarterly | yearly | one_time
  limitCredits    Int      @default(0)
  spentCredits    Int      @default(0)
  limitUsd        Float    @default(0)
  spentUsd        Float    @default(0)
  currency        String   @default("USD")
  status          String   @default("active") // active | exceeded | paused | expired
  startDate       DateTime @default(now())
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries         BudgetEntry[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([scope, scopeId])
  @@index([status])
}

// A budget entry — individual spending record.
model BudgetEntry {
  id              String   @id @default(cuid())
  budgetId        String
  toolCallId      String?
  agentRunId      String?
  amountCredits   Int      @default(0)
  amountUsd       Float    @default(0)
  category        String   @default("other") // ai | api | ads | infra | other
  description     String?
  createdAt       DateTime @default(now())

  budget          Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([agentRunId])
}

// A company memory record — facts, knowledge, decisions, etc.
model Memory {
  id              String   @id @default(cuid())
  workspaceId     String
  organizationId  String
  type            String   // fact | knowledge | decision | preference | outcome | lesson | active_context | historical_context | episodic
  content         String
  source          String   @default("system") // agent | user | system | external
  sourceId        String?  // agentRunId, userId, etc.
  confidence      Float    @default(0.5) // 0.0 - 1.0
  owner           String?
  accessPolicy    String   @default("workspace") // workspace | private | shared
  lifecycle       String   @default("medium") // permanent | long | medium | short
  expiresAt       DateTime?
  tags            String   @default("[]") // JSON array
  relatedMemoryIds String  @default("[]") // JSON array
  verifiedBy      String?
  verifiedAt      DateTime?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([organizationId])
  @@index([type])
  @@index([tags])
}

// A shared event — drives automations, notifications, analytics, audit.
model Event {
  id              String   @id @default(cuid())
  workspaceId     String?
  organizationId  String?
  type            String   // task.created, agent.run.completed, approval.requested, ...
  actor           String?  // userId or agentId
  actorType       String   @default("user") // user | agent | system
  resourceType    String?
  resourceId      String?
  metadata        String   @default("{}") // JSON
  correlationId   String?
  source          String   @default("system")
  createdAt       DateTime @default(now())

  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([organizationId])
  @@index([type])
  @@index([correlationId])
  @@index([createdAt])
}

// A detected opportunity — proactive opportunity identification.
model DetectedOpportunity {
  id              String   @id @default(cuid())
  workspaceId     String
  organizationId  String
  type            String   // declining_metrics | abandoned_tasks | customer_complaints | emerging_leads | product_opportunities | security_risks | broken_workflows | expensive_processes | growth_opportunities
  title           String
  description     String
  evidence        String   @default("[]") // JSON array
  confidence      Float    @default(0.5)
  recommendedAction String?
  expectedImpact  String?
  urgency         String   @default("medium") // low | medium | high | critical
  risk            String   @default("low")
  status          String   @default("open") // open | acknowledged | acted_on | dismissed
  dismissedBy     String?
  dismissedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([urgency])
}

// An AI recommendation — next-action suggestions.
model Recommendation {
  id              String   @id @default(cuid())
  workspaceId     String
  organizationId  String
  type            String
  title           String
  what            String
  why             String
  evidence        String   @default("[]") // JSON array
  expectedBenefit String?
  risk            String   @default("low")
  cost            Int      @default(0) // credits
  nextAction      String?
  status          String   @default("pending") // pending | accepted | rejected | implemented
  acceptedById    String?
  acceptedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
}

// ── Phase 5: Company Business Domain Models ──

// A product or service offered by the company.
model Product {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  name            String
  description     String?
  type            String   @default("product") // product | service | subscription | digital
  status          String   @default("active") // active | inactive | discontinued | beta
  price           Float    @default(0)
  currency        String   @default("USD")
  unit            String?  // per_month | per_year | per_unit | one_time
  sku             String?
  category        String?
  tags            String   @default("[]") // JSON array
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  deals           Deal[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
}

// A customer or lead in the CRM.
model Customer {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  name            String
  email           String?
  phone           String?
  company         String?  // their company name
  type            String   @default("lead") // lead | prospect | customer | churned | partner
  status          String   @default("new") // new | contacted | qualified | proposal | negotiation | won | lost
  source          String?  // website | referral | ads | outbound | event | other
  value           Float    @default(0) // estimated lifetime value
  currency        String   @default("USD")
  tags            String   @default("[]") // JSON array
  notes           String?
  metadata        String   @default("{}") // JSON
  ownerId         String?  // assigned sales rep
  lastContactedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  deals           Deal[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@index([type])
  @@index([ownerId])
}

// An initiative is a cross-functional effort that may span multiple goals and plans.
model Initiative {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  name            String
  description     String?
  status          String   @default("active") // active | paused | completed | cancelled
  priority        String   @default("medium") // low | medium | high | urgent
  startDate       DateTime?
  endDate         DateTime?
  budget          Float    @default(0)
  currency        String   @default("USD")
  ownerId         String?
  goalIds         String   @default("[]") // JSON array of Goal IDs
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
}

// A deal in the sales pipeline.
model Deal {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  customerId      String
  productId       String?
  title           String
  description     String?
  stage           String   @default("lead") // lead | qualified | proposal | negotiation | won | lost
  value           Float    @default(0)
  currency        String   @default("USD")
  probability     Int      @default(0) // 0-100
  expectedCloseDate DateTime?
  actualCloseDate DateTime?
  ownerId         String?  // assigned sales rep
  source          String?
  tags            String   @default("[]") // JSON array
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([customerId])
  @@index([stage])
  @@index([ownerId])
}

// A financial transaction (income, expense, or transfer).
model Transaction {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  type            String   // income | expense | transfer
  category        String   // revenue | cost_of_goods | marketing | salaries | infrastructure | tools | other
  amount          Float
  currency        String   @default("USD")
  description     String?
  date            DateTime @default(now())
  status          String   @default("confirmed") // pending | confirmed | disputed | reversed
  source          String?  // manual | stripe | dodo | bank | agent
  reference       String?  // invoice number, receipt ID, etc.
  tags            String   @default("[]") // JSON array
  metadata        String   @default("{}") // JSON
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([type])
  @@index([category])
  @@index([date])
}

// ── Phase 7: Research & Knowledge System ──

// A knowledge base is a structured collection of articles, notes, and
// research findings that can be searched and used as agent context.
model KnowledgeBase {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  name            String
  description     String?
  visibility      String   @default("workspace") // workspace | private | shared
  ownerId         String?
  tags            String   @default("[]") // JSON array
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  articles        KnowledgeArticle[]

  @@index([organizationId])
  @@index([workspaceId])
}

// An article within a knowledge base.
model KnowledgeArticle {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  title           String
  content         String   // markdown
  summary         String?
  source          String   @default("manual") // manual | research | agent | import
  sourceUrl       String?
  tags            String   @default("[]") // JSON array
  status          String   @default("draft") // draft | published | archived
  version         Int      @default(1)
  wordCount       Int      @default(0)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  citations       Citation[]

  @@index([knowledgeBaseId])
  @@index([status])
}

// A research session tracks a web-research workflow with citations.
model ResearchSession {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  query           String   // the research question
  status          String   @default("pending") // pending | running | completed | failed | cancelled
  findings        String   @default("{}") // JSON: structured findings
  summary         String?  // AI-generated summary
  agentRunId      String?
  ownerId         String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  citations       Citation[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
}

// A citation from a research session, linked to a source URL.
model Citation {
  id              String   @id @default(cuid())
  researchSessionId String?
  knowledgeArticleId String?
  url             String
  title           String?
  snippet         String?  // relevant excerpt
  publishedAt     DateTime?
  accessedAt      DateTime @default(now())
  credibility     String   @default("medium") // low | medium | high
  metadata        String   @default("{}") // JSON

  researchSession ResearchSession? @relation(fields: [researchSessionId], references: [id], onDelete: Cascade)
  knowledgeArticle KnowledgeArticle? @relation(fields: [knowledgeArticleId], references: [id], onDelete: Cascade)

  @@index([researchSessionId])
  @@index([knowledgeArticleId])
}

// ── Phase 7: Security Hardening ──

// A security event for monitoring, alerting, and audit.
model SecurityEvent {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  type            String   // token.exposed | failed_auth_spike | permission_denied | suspicious_activity | token_expired | key_rotated
  severity        String   @default("medium") // low | medium | high | critical
  description     String
  actorId         String?
  resourceType    String?
  resourceId      String?
  ipAddress       String?
  metadata        String   @default("{}") // JSON
  resolved        Boolean  @default(false)
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
}

// ── Phase 7: Analytics & Observability ──

// A time-series metric for analytics and observability.
model Metric {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  name            String   // e.g., "agent.runs.completed", "task.cycle_time"
  value           Float
  unit            String?  // count | ms | credits | percent | currency
  dimensions      String   @default("{}") // JSON: { agentId, status, platform, ... }
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([name])
  @@index([timestamp])
}

// ── Phase 8: Sandbox Execution ──

// A sandbox code execution run — tracks isolated code execution by agents.
model SandboxRun {
  id              String   @id @default(cuid())
  workspaceId     String
  agentRunId      String?
  taskId          String?
  language        String   // javascript | typescript | python | shell
  code            String   // the code to execute
  status          String   @default("pending") // pending | running | completed | failed | timeout | cancelled
  stdout          String   @default("")
  stderr          String   @default("")
  exitCode        Int?
  durationMs      Int?
  memoryMb        Int?
  timeoutSec      Int      @default(30)
  error           String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([agentRunId])
  @@index([status])
  @@index([createdAt])
}

// ── Phase 8: Sales & Support ──

// A support ticket from a customer or internal user.
model Ticket {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  customerId      String?  // link to Customer if applicable
  subject         String
  description     String
  status          String   @default("open") // open | in_progress | waiting_on_customer | resolved | closed | escalated
  priority        String   @default("medium") // low | medium | high | urgent
  category        String   @default("general") // general | billing | technical | bug | feature_request | account | other
  channel         String   @default("internal") // internal | email | chat | web | api
  assigneeId      String?  // assigned agent or user
  reporterId      String?  // who reported the ticket
  slaDueAt        DateTime?  // SLA deadline
  resolvedAt      DateTime?
  closedAt        DateTime?
  firstResponseAt DateTime?
  tags            String   @default("[]") // JSON array
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  comments        TicketComment[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([customerId])
  @@index([slaDueAt])
}

// A comment on a support ticket.
model TicketComment {
  id              String   @id @default(cuid())
  ticketId        String
  authorId        String?
  authorType      String   @default("user") // user | agent | system
  body            String
  isInternal      Boolean  @default(false) // internal notes vs customer-visible
  createdAt       DateTime @default(now())

  ticket          Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

// ── Phase 8: Multi-Tenancy Hardening ──

// Per-workspace resource quotas and limits.
model WorkspaceQuota {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String
  maxAgents       Int      @default(10)
  maxTasks        Int      @default(1000)
  maxDocuments    Int      @default(500)
  maxAutomations  Int      @default(50)
  maxTickets      Int      @default(500)
  maxStorageMb    Int      @default(5000)
  maxAgentRunsPerDay Int   @default(100)
  maxSandboxRunsPerDay Int @default(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@index([organizationId])
}

// ── Phase 9: Deployment Pipeline ──

// A deployment record — tracks deployments triggered by the coding loop or manually.
model Deployment {
  id              String   @id @default(cuid())
  workspaceId     String
  organizationId  String
  environment     String   @default("production") // production | staging | preview
  status          String   @default("pending") // pending | building | deploying | live | failed | rolled_back | cancelled
  trigger         String   @default("manual") // manual | coding_loop | pr_merge | scheduled
  prNumber        Int?
  commitSha       String?
  branch          String?
  buildLog        String   @default("")
  deployLog       String   @default("")
  healthCheckUrl  String?
  healthStatus    String?  // healthy | unhealthy | degraded | unknown
  rollbackFromId  String?  // ID of the deployment being rolled back to
  triggeredBy     String?
  approvedBy      String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([organizationId])
  @@index([status])
  @@index([environment])
  @@index([createdAt])
}

// ── Phase 9: Governance & Compliance ──

// A governance policy — rules that govern company operations.
model Policy {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  title           String
  description     String?
  type            String   @default("operational") // operational | financial | security | privacy | data_retention | approval | spending
  status          String   @default("active") // active | draft | archived | superseded
  version         Int      @default(1)
  rules           String   @default("[]") // JSON array of rule objects
  effectiveFrom   DateTime @default(now())
  effectiveUntil  DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([type])
  @@index([status])
}

// A compliance check — verifies that a specific rule or policy is being followed.
model ComplianceCheck {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  policyId        String?
  checkName       String
  description     String?
  status          String   @default("pending") // pending | passed | failed | warning | not_applicable
  severity        String   @default("medium") // low | medium | high | critical
  details         String   @default("{}") // JSON
  remediation     String?
  checkedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@index([checkedAt])
}

// A data retention rule — defines how long data is kept before deletion.
model RetentionRule {
  id              String   @id @default(cuid())
  organizationId  String
  dataType        String   // events | memories | audit_events | agent_runs | tool_calls | tickets | sandbox_runs
  retentionDays   Int      @default(365)
  action          String   @default("archive") // archive | delete | anonymize
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dataType])
}

// ── Phase 10: Observability v2 ──

// Time-series telemetry data point — durable storage for metrics over time.
model TelemetryPoint {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  metricName      String   // e.g. "api.response_time", "db.query_duration", "agent.run_duration"
  metricType      String   @default("gauge") // gauge | counter | histogram | summary
  value           Float
  unit            String   @default("ms") // ms | bytes | count | percent | ratio
  labels          String   @default("{}") // JSON map of labels/tags
  traceId         String?  // optional distributed trace correlation
  spanId          String?  // optional span within a trace
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([metricName])
  @@index([timestamp])
  @@index([traceId])
  @@index([organizationId, metricName, timestamp])
}

// Alert definition and state.
model Alert {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  name            String
  description     String   @default("")
  severity        String   @default("warning") // info | warning | error | critical
  status          String   @default("active") // active | resolved | suppressed | pending
  source          String   @default("system") // system | metric | trace | log | manual
  metricName      String?  // the metric this alert is based on
  condition       String   @default("{}") // JSON: { operator, threshold, window }
  currentValue    Float?
  threshold       Float?
  triggerCount    Int      @default(0)
  lastTriggeredAt DateTime?
  resolvedAt      DateTime?
  acknowledgedBy  String?
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([metricName])
  @@index([createdAt])
}

// Service Level Objective — defines targets for service quality.
model SLO {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String   @default("")
  metricName      String   // the metric being tracked (e.g. "api.response_time")
  target          Float    // target value (e.g. 200 for 200ms p99)
  targetPercentile Float   @default(99.0) // percentile (p50, p90, p99)
  windowDays      Int      @default(30) // rolling window
  status          String   @default("active") // active | paused | breached | met
  errorBudget     Float    @default(1.0) // 0-1, fraction of allowed misses
  errorBudgetUsed Float    @default(0.0) // 0-1, fraction consumed
  lastEvaluatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([metricName])
}

// Distributed trace — groups spans for request tracing.
model Trace {
  id              String   @id @default(cuid())
  organizationId  String
  traceId         String   @unique
  rootSpanName    String
  status          String   @default("ok") // ok | error | timeout
  durationMs      Float
  spanCount       Int      @default(0)
  serviceCount    Int      @default(0)
  labels          String   @default("{}")
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([traceId])
  @@index([status])
  @@index([startedAt])
}

// Individual span within a trace.
model Span {
  id              String   @id @default(cuid())
  organizationId  String
  traceId         String
  spanId          String   @unique
  parentSpanId    String?
  name            String
  service         String
  operation       String
  status          String   @default("ok") // ok | error | timeout
  durationMs      Float
  startTime       DateTime @default(now())
  endTime         DateTime?
  attributes      String   @default("{}") // JSON
  events          String   @default("[]") // JSON array of span events
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([traceId])
  @@index([spanId])
  @@index([service])
  @@index([startTime])
}

// Retention policy for telemetry and log data.
model RetentionPolicy {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  dataType        String   // telemetry | traces | spans | metrics | logs | audit_events
  retentionDays   Int      @default(30)
  action          String   @default("delete") // delete | archive | aggregate
  enabled         Boolean  @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dataType])
  @@index([enabled])
}

// ── Phase 11: Finance & Billing v2 ──

model Invoice {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  customerId      String?
  number          String   @unique
  status          String   @default("draft") // draft | sent | paid | overdue | cancelled | void
  type            String   @default("sales") // sales | purchase | credit | debit
  issueDate       DateTime @default(now())
  dueDate         DateTime
  subtotal        Float    @default(0)
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  discountRate    Float    @default(0)
  discountAmount  Float    @default(0)
  total           Float    @default(0)
  currency        String   @default("USD")
  notes           String   @default("")
  terms           String   @default("")
  paidAmount      Float    @default(0)
  paidAt          DateTime?
  sentAt          DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems       InvoiceLineItem[]

  @@index([organizationId])
  @@index([status])
  @@index([customerId])
  @@index([dueDate])
  @@index([number])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  taxRate     Float    @default(0)
  discountRate Float   @default(0)
  total       Float    @default(0)
  category    String?  // revenue category
  createdAt   DateTime @default(now())

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Expense {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  vendor          String
  description     String   @default("")
  category        String   @default("general") // general | software | hardware | marketing | travel | payroll | office | other
  amount          Float
  currency        String   @default("USD")
  status          String   @default("pending") // pending | approved | rejected | reimbursed
  expenseDate     DateTime @default(now())
  receiptUrl      String?
  approvedBy      String?
  approvedAt      DateTime?
  submittedBy     String?
  tags            String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([expenseDate])
}

model RevenueRecognition {
  id              String   @id @default(cuid())
  organizationId  String
  invoiceId       String?
  amount          Float
  recognizedDate  DateTime @default(now())
  period          String   // YYYY-MM
  type            String   @default("sales") // sales | service | subscription | other
  status          String   @default("recognized") // recognized | deferred | adjusted
  notes           String   @default("")
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([period])
  @@index([invoiceId])
  @@index([status])
}

model PayrollRecord {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  employeeName    String
  employeeId      String?
  period          String   // YYYY-MM
  grossAmount     Float
  taxWithheld     Float    @default(0)
  netAmount       Float    @default(0)
  benefits        Float    @default(0)
  status          String   @default("draft") // draft | approved | paid | pending | processed | failed
  payDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // ── Phase 13: HR & People Ops (additive) ──
  hrEmployeeId    String?  // references Employee.id
  payPeriodStart  DateTime?
  payPeriodEnd    DateTime?
  deductions      Float    @default(0)
  currency        String   @default("USD")
  payType         String   @default("salary") // salary | hourly | bonus | commission
  hoursWorked     Float?
  overtimeHours   Float?
  metadata        String   @default("{}") // JSON

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hrEmployee      Employee?   @relation(fields: [hrEmployeeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([period])
  @@index([status])
  @@index([employeeId])
  @@index([hrEmployeeId])
  @@index([payDate])
}

model TaxRecord {
  id              String   @id @default(cuid())
  organizationId  String
  period          String   // YYYY-MM or YYYY-Q1 etc
  type            String   @default("sales_tax") // sales_tax | income_tax | payroll_tax | vat | gst
  jurisdiction    String   @default("") // country/state/country code
  taxableAmount   Float    @default(0)
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  status          String   @default("calculated") // calculated | filed | paid
  filedAt         DateTime?
  paidAt          DateTime?
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([period])
  @@index([type])
  @@index([status])
}

// ── Phase 12: API Platform ──
// NOTE: Named PlatformApiKey to avoid collision with the existing user-scoped
// ApiKey model (used by the v1 public API). This org-scoped key backs the
// Developer Portal API platform (rate limiting, usage logging, etc.).

model PlatformApiKey {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  name            String
  description     String   @default("")
  keyPrefix       String   // first 12 chars for identification
  keyHash         String   @unique // hashed full key
  scopes          String   @default("[]") // JSON array of scopes
  rateLimitPerMin Int      @default(60)
  rateLimitPerDay Int      @default(10000)
  lastUsedAt      DateTime?
  lastUsedIp      String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedBy       String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
  @@index([revokedAt])
}

model ApiUsageLog {
  id              String   @id @default(cuid())
  organizationId  String
  apiKeyId        String?
  endpoint        String
  method          String
  statusCode      Int
  responseTimeMs  Int
  requestBodySize Int?
  responseBodySize Int?
  ipAddress       String?
  userAgent       String?
  rateLimited     Boolean  @default(false)
  timestamp       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([apiKeyId])
  @@index([endpoint])
  @@index([timestamp])
  @@index([rateLimited])
}

model WebhookSubscription {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  name            String
  url             String
  secret          String   // for HMAC signing
  events          String   @default("[]") // JSON array of event types
  status          String   @default("active") // active | paused | disabled
  lastDeliveryAt  DateTime?
  lastDeliveryStatus String?
  lastDeliveryCode Int?
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([events])
}

model SdkConfig {
  id              String   @id @default(cuid())
  organizationId  String
  language        String   // javascript | python | go | curl | rust
  packageName     String   @default("@lazynext/sdk")
  version         String   @default("1.0.0")
  baseUrl         String   @default("https://api.lazynext.com")
  config          String   @default("{}") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([language])
}

// ── Phase 12: Knowledge Management v2 ──

model KnowledgeDocument {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  parentId        String?  // for wiki hierarchy
  slug            String   // unique within org for wiki URLs
  title           String
  content         String   @default("") // markdown content
  excerpt         String   @default("")
  tags            String   @default("[]") // JSON array
  links           String   @default("[]") // JSON array of {targetId, label}
  status          String   @default("draft") // draft | published | archived
  version         Int      @default(1)
  currentVersionId String? // points to latest KnowledgeVersion
  authorId        String
  lastEditorId    String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          KnowledgeDocument? @relation("KnowledgeHierarchy", fields: [parentId], references: [id])
  children        KnowledgeDocument[] @relation("KnowledgeHierarchy")
  versions        KnowledgeVersion[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([parentId])
  @@index([slug])
  @@index([status])
}

model KnowledgeVersion {
  id              String   @id @default(cuid())
  documentId      String
  version         Int
  content         String
  excerpt         String
  editorId        String
  changeSummary   String   @default("")
  createdAt       DateTime @default(now())

  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([version])
}

model KnowledgeLink {
  id              String   @id @default(cuid())
  organizationId  String
  sourceId        String
  targetId        String
  label           String   @default("")
  linkType        String   @default("reference") // reference | related | prerequisite | extension
  createdBy       String
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
  @@index([organizationId])
}

model KnowledgeSearchIndex {
  id              String   @id @default(cuid())
  organizationId  String
  documentId      String?
  memoryId        String?
  researchId      String?
  entityType      String   // document | memory | research
  title           String
  content         String
  tags            String   @default("[]")
  keywords        String   @default("[]")
  relevanceScore  Float    @default(0)
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
  @@index([entityType])
}

// ── Phase 13: Calendar & Scheduling ──

model CalendarEvent {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  title           String
  description     String   @default("")
  type            String   @default("meeting") // meeting | deadline | reminder | milestone | block | time_off
  status          String   @default("scheduled") // scheduled | in_progress | completed | cancelled
  startDate       DateTime
  endDate         DateTime
  allDay          Boolean  @default(false)
  timezone        String   @default("UTC")
  location        String   @default("")
  meetingUrl      String?
  organizerId     String
  attendees       String   @default("[]") // JSON array of { userId, status, responseAt }
  resources       String   @default("[]") // JSON array of { resourceId, name, type }
  recurrence      String?  // RFC 5545 RRULE string
  recurrenceParentId String? // for instances of recurring events
  color           String   @default("")
  tags            String   @default("[]")
  reminders       String   @default("[]") // JSON array of { minutes, type }
  linkedTaskId    String?
  linkedGoalId    String?
  linkedProjectId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([startDate])
  @@index([endDate])
  @@index([organizerId])
  @@index([linkedTaskId])
  @@index([linkedGoalId])
  @@index([linkedProjectId])
}

model CalendarResource {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  name            String
  type            String   @default("room") // room | equipment | person
  capacity        Int      @default(1)
  location        String   @default("")
  description     String   @default("")
  availability    String   @default("[]") // JSON array of availability windows
  bookingPolicy   String   @default("{}") // JSON config
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([type])
  @@index([active])
}

model CalendarSync {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  provider        String   // google | outlook | ical | caldav
  externalCalendarId String
  syncToken       String?
  lastSyncAt      DateTime?
  syncDirection   String   @default("two_way") // one_way_import | one_way_export | two_way
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([provider])
}

// ── Phase 13: HR & People Ops ──

model Employee {
