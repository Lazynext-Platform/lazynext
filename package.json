{
  "name": "lazynext",
  "version": "0.1.0",
  "private": true,
  "description": "Lazynext is an AI e-commerce ad studio for generating UGC product ads, reference-ad remakes, AI drama ads, and ad skits, powered by Atlas Cloud multi-model workflows.",
  "scripts": {
    "dev": "npm run platform:prepare && next dev",
    "dev:vercel": "DEPLOY_TARGET=vercel npm run dev",
    "build": "npm run prisma:generate && npm run platform:prepare && next build",
    "build:vercel": "DEPLOY_TARGET=vercel npm run build",
    "start": "next start",
    "test": "node --test --experimental-strip-types --no-warnings test/**/*.test.ts",
    "lint": "next lint",
    "postinstall": "npm run prisma:generate && npm run platform:prepare",
    "prisma:generate": "node scripts/generate-prisma-clients.mjs",
    "platform:prepare": "node scripts/prepare-platform.mjs",
    "db:push": "prisma db push",
    "db:push:vercel": "npm run prisma:generate && prisma db push --schema prisma/.generated/schema.neon.prisma",
    "db:studio": "prisma studio",
    "cf:prepare": "DEPLOY_TARGET=cloudflare npm run prisma:generate && DEPLOY_TARGET=cloudflare npm run platform:prepare && node scripts/patch-wrangler-types.mjs",
    "cf:build": "npm run cf:prepare && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:prepare && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:prepare && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "setup:dodo": "node scripts/setup-dodo-products.mjs",
    "setup:dodo:localized": "node scripts/setup-dodo-localized-prices.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@neondatabase/serverless": "^0.10.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.6.1",
    "dodopayments": "^2.47.0",
    "lucide-react": "^1.22.0",
    "next": "^14.2.15",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.15.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^13.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3",
    "wrangler": "^4.59.2"
  },
  "overrides": {
    "brace-expansion": "^2.1.3",
    "glob": "^10.4.6",
    "fast-xml-parser": "^5.6.1",
    "uuid": "^11.1.1",
    "undici": "^7.0.0",
    "deepmerge-ts": "^8.0.2"
  }
}
